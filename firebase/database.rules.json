{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        "$slot": {
          ".write": "auth != null && auth.uid === $uid && !root.child('banned').child(auth.uid).exists() && root.child('config').child('writesOpen').val() !== false",
          ".validate": "$slot.matches(/^[0-9]$/) && newData.hasChildren(['name', 'created', 'settings'])",
          "name": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9 '_.!?()-]{3,32}$/)"
          },
          "created": {
            ".validate": "newData.val() === now"
          },
          "settings": {
            ".validate": "newData.isString() && newData.val().length <= 65536"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "banned": {
      ".read": false,
      ".write": false
    },
    "config": {
      ".read": true,
      ".write": false
    }
  }
}
